#!/usr/bin/env bash

set -e

echo "==> gofmt"
if [ -n "$(gofmt -l .)" ]; then
    echo "Files need formatting:"
    gofmt -l .
    exit 1
fi

echo "==> go mod tidy"
go mod tidy

echo "==> go mod vendor"
go mod vendor

if ! git diff --quiet; then
    echo "Generated dependency files are out of date:"
    git diff --stat
    git diff
    exit 1
fi

echo "==> go vet"
go vet -mod=vendor ./...

echo "==> staticcheck"
go tool staticcheck ./...

echo "==> go test"
go test -mod=vendor ./...

echo "All checks passed."
